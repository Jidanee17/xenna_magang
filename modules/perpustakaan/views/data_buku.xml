<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="data_buku_view_list" model="ir.ui.view">
            <field name="name">data_buku_view_list</field>
            <field name="model">data.buku</field>
            <field name="arch" type="xml">
                <list string="data_buku_tree">
                    <field name="name"/>
                    <field name="kategori_id"/>
                    <field name="jumlah_buku"/>
                    <field name="penerbit"/>
                    <field name="tahun_terbit"/>
                    <field name="jumlah_halaman"/>
                    <field name="penulis"/>
                </list>
            </field>
        </record>

        <record id="data_buku_view_form" model="ir.ui.view">
            <field name="name">data_buku_view_form</field>
            <field name="model">data.buku</field>
            <field name="arch" type="xml">
                <form string="Data Buku">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="kategori_id"/>
                            <field name="penerbit"/>
                            <field name="tahun_terbit"/>
                            <field name="jumlah_halaman"/>
                            <field name="penulis"/>
                            <field name="penerbit"/>
                            <field name="jumlah_halaman" min="0"/>
                            <field name="jumlah_buku" min="0"/>
                            <field name="jumlah_tersedia" min="0"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="data_buku_view_search" model="ir.ui.view">
        <field name="name">data.buku.search</field>
        <field name="model">data.buku</field>
        <field name="arch" type="xml">
            <search string="Cari Buku">
                <field name="name"/>
                <field name="penulis"/>
                <field name="penerbit"/>
                <field name="kategori_id"/>
                <separator/>
                <filter
                    name="group_by_kategori"
                    string="Kelompokkan berdasarkan Kategori"
                    context="{'group_by': 'kategori_id'}"
                    />
                </search>
            </field>
        </record>

        <record id="data_buku_action" model="ir.actions.act_window">
            <field name="name">Data Buku</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">data.buku</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="data_buku_view_search"/>
        </record>

    </data>
</odoo>