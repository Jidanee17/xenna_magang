<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_equipment_loan_portal_own" model="ir.rule">
        <field name="name">Equipment Loan: Portal Own Records</field>
        <field name="model_id" ref="model_equipment_loan"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            [('borrower_id', '=', user.partner_id.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_equipment_loan_line_portal_own" model="ir.rule">
        <field name="name">Equipment Loan Line: Portal Own Records</field>
        <field name="model_id" ref="model_equipment_loan_line"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            [('loan_id.borrower_id', '=', user.partner_id.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_product_product_portal_own_loans" model="ir.rule">
        <field name="name">Product Variant: Portal Own Loan Products</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            [('equipment_loan_line_ids.loan_id.borrower_id', '=', user.partner_id.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_stock_lot_portal_own_loans" model="ir.rule">
        <field name="name">Lot/Serial: Portal Own Loan Serials</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            [('equipment_loan_line_ids.loan_id.borrower_id', '=', user.partner_id.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>