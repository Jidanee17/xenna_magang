<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_equipment_loan" model="ir.actions.report">
        <field name="name">Bukti Peminjaman</field>
        <field name="model">equipment.loan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">equipment_loan_tracker.report_equipment_loan_document</field>
        <field name="report_file">equipment_loan_tracker.report_equipment_loan_document</field>
        <field name="binding_model_id" ref="model_equipment_loan"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_equipment_loan_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="loan">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">
                            BUKTI PEMINJAMAN ALAT
                        </h2>
                        <p class="text-center">
                            Equipment Loan Tracker
                        </p>
                        <br/>
                        <table style="width: 100%;">

                            <tr>
                                <td style="width: 35%;">
                                    <strong>No Peminjam</strong>
                                </td>
                                <td>
                                    :
                                    <span t-field="loan.name"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="width: 35%;">
                                    <strong>Peminjam</strong>
                                </td>
                                <td>
                                    :
                                    <span t-field="loan.borrower_id"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Alat</strong>
                                </td>
                                <td>
                                    :
                                    <table style="display: inline-table; vertical-align: top; border-collapse: collapse;">
                                        <tr t-foreach="loan.loan_line_ids" t-as="line">
                                            <td style="padding: 0 4px 0 0; vertical-align: top; white-space: nowrap;">
                                                <span t-esc="line_index + 1"/>.
                                            </td>
                                            <td style="padding: 0; vertical-align: top;">
                                                <span t-field="line.equipment_id.name"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Tanggal Peminjaman</strong>
                                </td>
                                <td>
                                    :
                                    <span t-field="loan.loan_date"/>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <strong>Tanggal Jatuh Tempo</strong>
                                </td>
                                <td>
                                    :
                                    <span t-field="loan.due_date"/>
                                </td>
                            </tr>
                        </table>
                        <br/>
                        <br/>
                        <p>
                            Dengan ini dinyatakan bahwa peminjam telah
                            melakukan peminjaman alat sesuai dengan data
                            yang tercantum di atas.
                        </p>
                        <br/>
                        <div class="text-center">
                            <small>
                                Bukti peminjaman ini dibuat secara otomatis
                                oleh Equipment Loan Tracker.
                            </small>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>