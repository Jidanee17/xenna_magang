<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_inherit_loan" model="ir.ui.view">
        <field name="name">product.template.form.inherit.equipment.loan</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Equipment Loan Tracker">
                    <field name="is_damaged"/>
                    <field name="penalty_amount"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
