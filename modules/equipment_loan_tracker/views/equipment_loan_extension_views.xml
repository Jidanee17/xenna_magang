<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_equipment_loan_extension_list" model="ir.ui.view">
        <field name="name">equipment.loan.extension.list</field>
        <field name="model">equipment.loan.extension</field>
        <field name="arch" type="xml">
            <list string="Extension Requests">
                <field name="name"/>
                <field name="loan_id"/>
                <field name="requested_by"/>
                <field name="current_due_date"/>
                <field name="requested_due_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_loan_extension_form" model="ir.ui.view">
        <field name="name">equipment.loan.extension.form</field>
        <field name="model">equipment.loan.extension</field>
        <field name="arch" type="xml">
            <form string="Extension Request">

                <header>
                    <button
                        name="action_approve"
                        string="Approve"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'pending'"
                    />

                    <button
                        name="action_reject"
                        string="Reject"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'pending'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="pending,approved,rejected"
                    />
                </header>

                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="loan_id"/>
                            <field name="requested_by"/>
                        </group>

                        <group>
                            <field name="current_due_date"/>
                            <field
                                name="requested_due_date"
                                readonly="state != 'pending'"
                            />
                            <field name="state" invisible="1"/>
                        </group>
                    </group>

                    <group>
                        <field
                            name="reason"
                            readonly="state != 'pending'"
                        />
                    </group>

                </sheet>

            </form>
        </field>
    </record>

    <record id="action_equipment_loan_extension" model="ir.actions.act_window">
        <field name="name">Extension Requests</field>
        <field name="res_model">equipment.loan.extension</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
